<?xml version="1.0" encoding="utf-8"?>
<Settings>
  <!--图标 Other=其他；Nanoradar=纳雷-->
  <set key="Company" value="Nanoradar" />
  <!--********图标参数*********-->
  <!--是否显示网格-->
  <set key="IsDisplayGrid" value="false" />
  <!--是否显示Cluster图表-->
  <set key="IsDisplayCluster" value="false" />
  <!--刷新Nplot定时时间ms-->
  <set key="RefreshTimeCnt" value="100" />
  <!--X Min 整数   必须小于XMax-->
  <set key="XMin" value="-10" />
  <!--X Max 整数   必须大于XMin-->
  <set key="XMax" value="10" />
  <!--Y Min 整数   必须小于YMax-->
  <set key="YMin" value="0" />
  <!--Y Max 整数   必须大于XMin-->
  <set key="YMax" value="300" />
  <!--Z Min 整数   必须小于ZMax-->
  <set key="ZMin" value="0" />
  <!--Z Max 整数   必须大于ZMin-->
  <set key="ZMax" value="10" />
  <!--Image Size-->
  <set key="ImageSize" value="20" />
  <!--Image Enbale-->
  <set key="B_Image" value="false" />
  <!--********图标参数*********-->
  <!--*****************************************************-->
  <!--********文件存储参数*********-->
  <!--数据储存-->
  <set key="TargetData" value="False" />
  <!--文件大小-->
  <set key="FileSize" value="500" />
  <!--文件路径-->
  <set key="FileRoute" value="C:\\SaveData\" />
  <!--********文件存储参数*********-->
  <!--*****************************************************-->
  <!--********连接配置*********-->
  <!--历史雷达类型-->
  <set key="RadarType" value="TCR300" />
  <!--历史雷达通讯方式-->
  <set key="ConnType" value="TCP" />
  <!--COM -->
  <set key="COMNum" value="COM3" />
  <!--COM 波特率-->
  <set key="BaudCOM" value="460800" />
  <!--COM 奇偶校验位-->
  <set key="ParityCOM" value="None" />
  <!--COM 数据位-->
  <set key="DataBitCOM" value="8" />
  <!--COM 数据位-->
  <set key="StopBitCOM" value="One" />
  <!--设备索引-->
  <set key="CAN_Index" value="0" />
  <!--CAN波特率-->
  <set key="CAN_Baud" value="500Kbps" />
  <!--网口Ip-->
  <set key="Net_IP" value="192.168.10.123" />
  <!--网口端口-->
  <set key="Net_Port" value="50000" />
  <!--********连接配置*********-->
  <!--*****************************************************-->
  <!--速度选择 0:横向速度*SinA + 纵向速度*CosA; 1:横向速度和纵向速度的平方和开根（无方向）;2:横向速度; 3:纵向速度 -->
  <set key="VelSelect" value="3" />
  <!--*****************************************************-->
  <!--********目标文本显示*********-->
  <!--显示距离-->
  <set key="B_Distance" value="False" />
  <!--显示角度-->
  <set key="B_Angle" value="False" />
  <!--显示速度-->
  <set key="B_Vrel" value="False" />
  <!--显示类型-->
  <set key="B_Class" value="False" />
  <!--显示RCS\SNR-->
  <set key="B_RCS" value="False" />
  <!--显示动态状态-->
  <set key="B_dynProp" value="False" />
  <!--显示X坐标-->
  <set key="B_DistanceX" value="True" />
  <!--显示Y坐标-->
  <set key="B_DistanceY" value="False" />
  <!--显示横向速度-->
  <set key="B_VrelX" value="False" />
  <!--显示纵向速度-->
  <set key="B_VrelY" value="False" />
  <!--********目标文本显示*********-->
  <!--*****************************************************-->
  <!--********TSR20默认参数*********-->
  <!--最小检测距离-->
  <set key="MinCheckDistance" value="0.3" />
  <!--最大检测距离-->
  <set key="MaxCheckDistance" value="3" />
  <!--左侧检测范围-->
  <set key="LeftCheckRange" value="-0.1" />
  <!--最大检测距离-->
  <set key="RightCheckRange" value="0.1" />
  <!--落杆时间-->
  <set key="FallTime" value="6" />
  <!--灵敏度设置-->
  <set key="SensitivitySet" value="1" />
  <!--杆的位置-->
  <set key="LocationSet" value="2" />
  <!--是否人车区分-->
  <set key="DivClass" value="false" />
  <!--对射模式-->
  <set key="Crossshot" value="0" />
  <!--检测方向-->
  <set key="CheckDirection" value="0" />
  <!--道闸杆长度 m-->
  <set key="LengthRod" value="5" />
  <!--********TSR20默认参数*********-->
  <!--*****************************************************-->
  <!--********视频参数*********-->
  <!--相机品牌-->
  <set key="CameraManufacturer" value="0" />
  <!--相机名称-->
  <set key="CameraUser" value="admin" />
  <!--相机密码-->
  <set key="CameraPassWord" value="rvssp100" />
  <!--相机地址-->
  <set key="CameraIP" value="192.168.83.111" />
  <!--********视频参数*********-->
  <!--*****************************************************-->
  <!--********坐标过滤参数*********-->
  <!--是否启用坐标过滤-->
  <set key="CoordinateFilter" value="False" />
  <!--P1_X 左上角X坐标-->
  <set key="P1_X" value="-5" />
  <!--P1_Y 左上角Y坐标-->
  <set key="P1_Y" value="5" />
  <!--P2_X 右下角X坐标-->
  <set key="P2_X" value="5" />
  <!--P2_Y 右下角Y坐标-->
  <set key="P2_Y" value="0" />
  <!--********坐标过滤参数*********-->
  <!--********车道计数参数*********-->
  <!--是否使用触发距离1-->
  <set key="B_TriggerDistance" value="True" />
  <!--触发车辆计数的距离1 单位m-->
  <set key="TriggerDistance" value="30" />
  <!--是否使用触发距离2-->
  <set key="B_TriggerDistanceTwo" value="True" />
  <!--触发车辆计数的距离2 单位m-->
  <set key="TriggerDistanceTwo" value="100" />
  <!--触发距离阈值 单位m 如触发距离是30m,则范围是[27,33]，则另一个触发距离不允许设置的范围为[24,36]，范围用来判断车辆是否通过触发线-->
  <!--且用于车流量统计，若车道方向为来向时，上一周期此目标距离小于触发距离且本周期该目标距离大于等于触发距离，车流量+1-->
  <set key="TriggerOffset" value="3" />
  <!--触发车辆计数周期 单位s-->
  <set key="TriggerTime" value="10" />
  <!--是否存储周期内所有车道总统计车数-->
  <set key="B_SaveTotal" value="True" />
  <!--********车道计数参数*********-->
  <!--显示雷达激活-->
  <set key="B_Alive" value="false" />
</Settings>